        <name>ReturnDate Greaterthan StartDate</name>
        <order/>
        <script><![CDATA[function onSubmit() {

    var istrueReturn = g_form.getBooleanValue('return');
    if (istrueReturn) {
        var sd = g_form.getValue('startdate');
        var rd = g_form.getValue('returndate');

        var sdate = getDateFromFormat(sd, g_user_date_format);
        var rdate = getDateFromFormat(rd, g_user_date_format);

        if (sdate > rdate) {
            g_form.addErrorMessage('Return date should be greater than Start Date');
            return false;
        }
    }
}]]></script>
