        <name>Hide details for Passport and visa</name>
        <order/>
        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading, isTemplate) {
   if (newValue === '') {
      return;
   }
   
    var ttd = g_form.getValue('travel_type');

    if (ttd == 'domestic' || ttd =='') {
        g_form.setDisplay('passport_details', true);
        g_form.setDisplay('visa_details', true);
    } else {
        g_form.setDisplay('passport_details', false);
		g_form.setMandatory('passport_details',true);
        g_form.setDisplay('visa_details', false);
		g_form.setMandatory('visa_details',true);
    }
   
}]]></script>
